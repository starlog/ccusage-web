{
  "name": "cc-usage-server",
  "version": "1.0.0",
  "private": true,
  "description": "Collects per-user Claude Code usage reports (from ccusage_report.py) and shows team statistics",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "seed:sample": "node --env-file-if-exists=.env scripts/seed-sample.js",
    "seed:clean": "node --env-file-if-exists=.env scripts/seed-sample.js --clean"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "express": "^5.2.1",
    "mongodb": "^7.6.0"
  }
}
