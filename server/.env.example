# Copy to .env (loaded automatically by `npm start` / `npm run dev`).
PORT=3200
HOST=0.0.0.0
# The `mongodb` docker container publishes 27017 on the host.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=cc_usage
# When set, uploads must send `Authorization: Bearer <token>` (script: --token / CCUSAGE_TOKEN).
INGEST_TOKEN=
